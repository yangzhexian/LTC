{
    "version": "2.0.0",
    "problemMatcher": [],
    "presentation": {
        "echo": true,
        "reveal": "always",
        "focus": false,
        "panel": "shared"
    },
    "tasks": [
        {
            "label": "HTTP PDF Server (port 8766)",
            "type": "shell",
            "command": "python3",
            "args": [
                "${workspaceFolder}/scripts/httpserver.py",
                "8766",
                "--dir",
                "${workspaceFolder}"
            ],
            "isBackground": true,
            "problemMatcher": {
                "pattern": [
                    {
                        "regexp": ".",
                        "file": 1,
                        "location": 2,
                        "message": 3
                    }
                ],
                "background": {
                    "activeOnStart": true,
                    "beginsPattern": "^LTC PDF Server",
                    "endsPattern": "."
                }
            },
            "presentation": {
                "group": "ltc_group",
                "panel": "dedicated",
                "clear": true
            }
        },
        {
            "label": "latexmk (continuous watch)",
            "type": "shell",
            "command": "latexmk",
            "args": [
                "-pdf",
                "-pvc",
                "-interaction=nonstopmode",
                "-e",
                "$pdf_previewer='cat';$pvc_view_file=0;",
                "main.tex"
            ],
            "isBackground": true,
            "problemMatcher": {
                "pattern": [
                    {
                        "regexp": ".",
                        "file": 1,
                        "location": 2,
                        "message": 3
                    }
                ],
                "background": {
                    "activeOnStart": true,
                    "beginsPattern": "^Latexmk: All targets",
                    "endsPattern": "."
                }
            },
            "presentation": {
                "group": "ltc_group",
                "panel": "dedicated",
                "clear": true
            }
        },
        {
            "label": "Initial Build",
            "type": "shell",
            "command": "latexmk",
            "args": [
                "-pdf",
                "-interaction=nonstopmode",
                "-f",
                "main.tex"
            ],
            "problemMatcher": [],
            "presentation": {
                "group": "ltc_group",
                "panel": "dedicated",
                "clear": false
            }
        },
        {
            "label": "Start All Services",
            "dependsOn": [
                "Initial Build",
                "latexmk (continuous watch)",
                "HTTP PDF Server (port 8766)"
            ],
            "dependsOrder": "sequence",
            "problemMatcher": [],
            "presentation": {
                "group": "ltc_group",
                "panel": "dedicated",
                "clear": true
            },
            "group": {
                "kind": "build",
                "isDefault": true
            }
        }
    ]
}
