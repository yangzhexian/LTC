{
    // ---- LaTeX Workshop Configuration ----

    // Automatically build on save
    "latex-workshop.latex.autoBuild.run": "onSave",

    // Enable built-in PDF viewer for the Host (SyncTeX support)
    // Guests access the PDF via HTTP server (auto-refresh, no SyncTeX)
    "latex-workshop.view.pdf.viewer": "tab",
    "latex-workshop.view.pdf.tab": true,

    // SyncTeX: forward search from .tex to PDF (Ctrl+Alt+J)
    "latex-workshop.synctex.afterBuild.enabled": true,
    // SyncTeX: backward search from PDF to .tex (Ctrl+Click in PDF)
    "latex-workshop.view.pdf.internal.synctex.keybinding": "ctrl-click",

    // ---- Build Recipe: latexmk with pdflatex ----
    "latex-workshop.latex.tools": [
        {
            "name": "latexmk",
            "command": "latexmk",
            "args": [
                "-pdflatex",
                "-interaction=nonstopmode",
                "-synctex=1",
                "-f",
                "%DOC%"
            ],
            "env": {}
        }
    ],

    "latex-workshop.latex.recipes": [
        {
            "name": "latexmk",
            "tools": ["latexmk"]
        }
    ],

    // Clean auxiliary files after build
    "latex-workshop.latex.clean.method": "globClean",
    "latex-workshop.latex.clean.files": [
        "*.aux",
        "*.bbl",
        "*.blg",
        "*.fdb_latexmk",
        "*.fls",
        "*.lof",
        "*.lot",
        "*.log",
        "*.out",
        "*.synctex.gz",
        "*.toc"
    ],

    // ---- General VS Code settings ----
    "files.autoSave": "onFocusChange",

    // Editor: use 2-space indentation for .tex files
    "[tex]": {
        "editor.tabSize": 2,
        "editor.wordWrap": "on"
    },

    "[latex]": {
        "editor.tabSize": 2,
        "editor.wordWrap": "on"
    }
}
